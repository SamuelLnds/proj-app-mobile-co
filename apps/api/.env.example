# Copier ce fichier en apps/api/.env (ignoré par Git) puis remplacer les valeurs.
# Ne jamais versionner de valeur réelle.

# Environnement d'exécution : development, test ou production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Doit correspondre à POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de infra/.env
DATABASE_URL=postgres://solar:change-me@localhost:5432/solar

# Au moins 32 caractères aléatoires
JWT_SECRET=change-me-with-at-least-32-random-characters

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=api
MQTT_PASSWORD=change-me

# Facultatif : jeton d'accès Expo pour les notifications push
EXPO_ACCESS_TOKEN=

# Mots de passe des utilisateurs de démonstration (script db:seed)
SEED_OPERATOR_PASSWORD=change-me
SEED_VIEWER_PASSWORD=change-me
