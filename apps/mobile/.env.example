# Copier en apps/mobile/.env (ignoré par Git).
# URL de l'API vue depuis le téléphone :
# - téléphone branché en USB : http://localhost:3000/v1 après `adb reverse tcp:3000 tcp:3000` ;
# - téléphone sur le même Wi-Fi : adresse IP du PC, par exemple http://192.168.1.10:3000/v1.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
# Source des données : mock (données d'exemple) ou api (API REST).
EXPO_PUBLIC_DATA_SOURCE=mock
# Scénario de la source mock : normal, device_offline, battery_full, no_alerts, phone_offline.
EXPO_PUBLIC_MOCK_SCENARIO=normal
