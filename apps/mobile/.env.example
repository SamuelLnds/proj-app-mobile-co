# Copier en apps/mobile/.env (ignoré par Git).
# URL de l'API vue depuis le téléphone : adresse IP du PC sur le Wi-Fi, pas localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/v1
# Source des données : mock (données d'exemple) ou api (issue #25).
EXPO_PUBLIC_DATA_SOURCE=mock
# Scénario de la source mock : normal, device_offline, battery_full, no_alerts, phone_offline.
EXPO_PUBLIC_MOCK_SCENARIO=normal
