# Copier ce fichier en infra/.env (ignoré par Git) puis remplacer le mot de passe.
# Ne jamais versionner de valeur réelle.
POSTGRES_USER=solar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=solar

# Port de la base sur la machine hôte. Le changer (par exemple 5433) si un
# PostgreSQL installé localement occupe déjà 5432, et reporter ce port dans
# DATABASE_URL de apps/api/.env.
DB_PORT=5432

# Broker MQTT (Mosquitto). Mots de passe des trois clients : choisir des valeurs
# longues et aléatoires, puis lancer « pnpm mqtt:setup ».
MQTT_API_PASSWORD=change-me
MQTT_SIMULATOR_PASSWORD=change-me
MQTT_DEVICE_PASSWORD=change-me
# Noms d'hôte acceptés par le certificat TLS, séparés par des virgules
# (ajouter l'hôte du tunnel quand l'ESP32 de Wokwi se connecte)
MQTT_TLS_HOSTS=localhost
# Ports sur la machine hôte
MQTT_PORT=1883
MQTTS_PORT=8883
