# Copier ce fichier en tools/simulator/.env (ignoré par Git) puis remplacer les valeurs.
# Ne jamais versionner de valeur réelle.

# Broker MQTT local (Mosquitto, voir infra/docker-compose.yml)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=simulator
MQTT_PASSWORD=change-me

# Code du site simulé (3 à 16 caractères, majuscules et chiffres)
SITE_CODE=SITE01

# Facultatif : le simulateur joue l'objet du site (statut, mesures, consignes), true ou false (défaut : false)
SIMULATE_DEVICE=false

# Mode objet du site : enrôlement auprès de l'API puis connexion par certificat sur 8883 (D027).
# Laisser vide pour les valeurs par défaut du développement. Aucun mot de passe : la demande doit
# être acceptée dans l'app (écran Objets) après comparaison de l'empreinte affichée ici.
DEVICE_NAME=
API_URL=
DEVICE_MQTT_URL=
BROKER_CA_PATH=

# Facultatif : panneaux dont la production est divisée par 5 (ex. P07,P12)
FAULTY_PANELS=

# Facultatif : panneaux absents du seed, publiés en plus des 20 panneaux (ex. P21)
EXTRA_PANELS=
