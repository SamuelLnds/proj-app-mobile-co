# Copier ce fichier en tools/simulator/.env (ignoré par Git) puis remplacer les valeurs.
# Ne jamais versionner de valeur réelle.

# Broker MQTT local (Mosquitto, voir infra/docker-compose.yml)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=simulator
MQTT_PASSWORD=change-me

# Code du site simulé (3 à 16 caractères, majuscules et chiffres)
SITE_CODE=SITE01

# Facultatif : panneaux dont la production est divisée par 5 (ex. P07,P12)
FAULTY_PANELS=

# Facultatif : panneaux absents du seed, publiés en plus des 20 panneaux (ex. P21)
EXTRA_PANELS=
