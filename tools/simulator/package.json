{
  "name": "simulator",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Simulateur des 20 panneaux : publication des mesures MQTT pour le développement et la démo",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
